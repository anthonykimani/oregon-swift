{
  "name": "oregon-courier-api",
  "version": "0.1.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "NODE_ENV=development nodemon -w './**/*.ts' --exec 'ts-node' service/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm migration:generate -- -d service/configs/ormconfig.ts",
    "migration:run": "npm run typeorm migration:run -- -d service/configs/ormconfig.ts",
    "migration:revert": "npm run typeorm migration:revert -- -d service/configs/ormconfig.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Oregon Swift Deliveries — Express API",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.6.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.14.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.21",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.13.13",
    "@types/pdfkit": "^0.17.6",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.2"
  }
}
